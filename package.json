  "devDependencies": {
    "@sinclair/typebox": "^0.34.41",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^20.0.0",
    "@types/yargs": "^17.0.35",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "yargs": "^18.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
